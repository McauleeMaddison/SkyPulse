.DS_Store
*.icloud

# Unity mobile project (generated locally by the editor)
mobile/Library/
mobile/Logs/
mobile/Temp/
mobile/Obj/
mobile/Build/
mobile/Builds/
mobile/UserSettings/
mobile/.vs/
mobile/*.csproj
mobile/*.sln

# VS Code workspace state is machine-specific; the small shared settings folder is tracked.
.vscode/workspaceStorage/
.vscode/.ropeproject/

# Krita writes these crash-recovery copies beside the real editable source file.
# Keep the real .kra artwork, but never commit a temporary autosave.
*.kra-autosave.kra
*.kra~
