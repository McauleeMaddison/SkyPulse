--- /dev/null
+++ b/mobile/Assets/Scripts/SkyPulseNativeGame.Roster3D.cs
@@ -0,0 +1,49 @@
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace SkyPulse.Mobile
+{
+    public sealed partial class SkyPulseNativeGame
+    {
+        SkyPulseProgressionStage unlockModelStage;
+        RawImage unlockModelView;
+
+        // Reuse the Hangar/training studio so reveals keep the same model,
+        // materials and wing cadence as the collection display.
+        void BindUnlockModel(Skin skin)
+        {
+            ReleaseUnlockModel();
+            string id=birdProgression?.Genome(skin.Id)?.appearance;
+            if(string.IsNullOrEmpty(id))id=skin.Id;
+            if(Resources.Load<GameObject>("SkyPulse/Birds3D/"+id)==null)return;
+            unlockRevealBirdTransform.sizeDelta=new Vector2(660,420);
+            var go=new GameObject("Unlocked 3D flight form",typeof(RectTransform),typeof(CanvasRenderer),typeof(RawImage),typeof(SkyPulseProgressionStage));
+            go.transform.SetParent(unlockRevealBirdTransform,false);
+            unlockModelView=go.GetComponent<RawImage>();var rect=unlockModelView.rectTransform;
+            rect.anchorMin=Vector2.zero;rect.anchorMax=Vector2.one;rect.offsetMin=rect.offsetMax=Vector2.zero;rect.sizeDelta=Vector2.zero;
+            // Stretch dimensions are resolved before constructing the camera.
+            Canvas.ForceUpdateCanvases();
+            unlockModelStage=go.GetComponent<SkyPulseProgressionStage>();
+            unlockModelStage.ReducedMotion=reduceMotionEnabled;
+            var portrait=new SkyPulseProgressionStage.Portrait{ModelId=id,At=Vector2.zero,Size=new Vector2(590,340),Accent=skin.Accent,Still=LoadPresentationPose(skin.UnlockPath)??LoadSprite(skin.ArtPath)};
+            unlockModelStage.Build(unlockModelView,new[]{portrait},false,768);
+            if(unlockModelStage.ModelPilotCount==0){ReleaseUnlockModel();return;}
+            unlockModelStage.SetFacing(reduceMotionEnabled?-12:32,false);
+            unlockRevealBirdImage.enabled=false;
+        }
+        void PresentUnlockModel(float progress)
+        {
+            if(unlockModelStage==null)return;
+            unlockModelStage.ReducedMotion=reduceMotionEnabled;
+            // The launch turns from a forward three-quarter presentation into
+            // its reference-facing flight pose while the wings remain alive.
+            if(!reduceMotionEnabled)unlockModelStage.SetFacing(Mathf.Lerp(32,-12,Mathf.SmoothStep(0,1,progress)),false);
+        }
+        void ReleaseUnlockModel()
+        {
+            if(unlockModelView!=null)Destroy(unlockModelView.gameObject);
+            unlockModelView=null;unlockModelStage=null;
+            if(unlockRevealBirdImage!=null)unlockRevealBirdImage.enabled=true;
+        }
+    }
+}
